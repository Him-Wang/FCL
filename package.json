{
  "name": "fcl",
  "productName": "FCL",
  "version": "1.4.7",
  "description": "FishCraftLauncher (FCL) — PCL 风格的 Minecraft 桌面启动器（Electron）",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "icon": "node tools/make-icon.js mint",
    "dist": "tools\\package-win.cmd",
    "dist:raw": "electron-builder --win --x64"
  },
  "author": "Hermintway",
  "license": "MIT",
  "build": {
    "appId": "com.fcl.launcher",
    "productName": "FCL",
    "copyright": "Copyright © 2026 Hermintway · 共同创造：DeepSeek Harness、WorkBuddy · 界面重构：AlexBlock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "FCL-${version}-${arch}.${ext}",
      "legalTrademarks": "FCL · FishCraftLauncher（见 README 致谢与设置-关于）"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FCL"
    },
    "asarUnpack": [
      "node_modules/@xmcl/**"
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!tools/**",
      "!shots/**",
      "!.build-tmp/**",
      "!FCL/**",
      "!docs/**",
      "!*.pdf",
      "!*.log",
      "!*.md",
      "!*.docx",
      "!.test-server/**",
      "!.temp-game/**",
      "build/icon.ico",
      "!design.md",
      "build/icon.png",
      "!.verify-game/**",
      "!vendor/**"
    ],
    "extraResources": [
      {
        "from": "vendor/easytier",
        "to": "easytier",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@xmcl/core": "^2.15.1",
    "@xmcl/user": "^4.4.2"
  }
}
